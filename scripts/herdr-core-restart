#!/usr/bin/env bash
# Restart herdr-core with the user session environment (no Claude Code variables).
# WARNING: this stops the live terminals of the core.
set -euo pipefail

SOCK=/run/user/$(id -u)/herdr-core/default.sock

# 1. Stop the core started by hc (transient units) and the holder.
systemctl --user stop 'hc-serve-*.service' 'hc-hold-*.service' 2>/dev/null || true

# 2. Start the persistent service.
systemctl --user restart herdr-core.service

# 3. Wait for the socket.
for _ in $(seq 1 20); do [ -S "$SOCK" ] && break; sleep 0.5; done
[ -S "$SOCK" ] || { echo "FAILED: $SOCK did not appear"; exit 1; }

# 4. Check that it answers.
printf '{"jsonrpc":"2.0","id":1,"method":"server.status","params":{}}\n' |
  timeout 3 python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall(sys.stdin.buffer.read()); print(s.recv(300).decode())' "$SOCK"

# 5. Check that it does not inherit Claude Code variables.
PID=$(systemctl --user show -p MainPID --value herdr-core.service)
if tr '\0' '\n' < /proc/"$PID"/environ | grep -q '^CLAUDE_CODE'; then
  echo "WARNING: the core still has CLAUDE_CODE_* variables"
else
  echo "OK: clean core (pid $PID)"
fi
